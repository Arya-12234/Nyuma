# Local Nyuma backend configuration.
# Copy this file to .env or server/.env and replace every placeholder.
# DATABASE_URL is the migration-owner connection used to apply migrations.
# After Stage A that role is nyuma_owner. It is not the API login.
# Creating nyuma_fn_constraint BYPASSRLS still requires a superuser the first time.
# APP_DATABASE_URL is nyuma_api. It inherits nyuma_app and no other Nyuma role.
# Set both passwords outside git. Do not commit them. Do not put a Supabase database host here.
DATABASE_URL=postgres://nyuma_owner:change-me@127.0.0.1:5433/nyuma
APP_DATABASE_URL=postgres://nyuma_api:change-me@127.0.0.1:5433/nyuma

# Supabase Auth. Leave these placeholders until a project exists.
# Do not set SUPABASE_SERVICE_ROLE_KEY. This API rejects that variable.
# The publishable anon key may also be copied into the frontend variables below.
# Never put a privileged key in frontend code or in a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Frontend. Vite exposes only VITE_ variables to the browser.
# VITE_SUPABASE_ANON_KEY is the publishable anon key, not a privileged key.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_NYUMA_API_URL=http://127.0.0.1:8787
# Optional. Only a legacy HS256 project uses this secret. Current projects verify
# ES256 or RS256 tokens from the project's JWKS endpoint. Leave it empty for those.
# The database verifier does not read this value. Stage B does not verify ES256 or
# RS256 inside PostgreSQL. Do not copy a production secret into the database.
SUPABASE_JWT_SECRET=

PORT=8787
HOST=127.0.0.1

# API process only. Migrations load this file for DATABASE_URL and do not read NYUMA_IDENTITY_MODE.
# NYUMA_IDENTITY_MODE is required for the API. There is no default and no silent raw-bearer path.
# NODE_ENV does not select the mode.
# local-hs256-test writes the original Supabase access token into nyuma.access_token.
# The API accepts that mode only when NODE_ENV is exactly test or development.
# Unset, empty, production, and any other NODE_ENV reject it. It is not production-safe.
# signer sends the original access token to the loopback signer and stores only the nya1 assertion.
# signer requires SIGNER_CLIENT_CREDENTIAL. A signer failure does not write the access token.
# Production requires signer and that credential.
NODE_ENV=development
# The signer client credential is shared with the signer process and is not a user JWT.
# It is at least 32 random bytes. Leave it empty until signer mode is selected.
# Do not add the HMAC signing key, ASSERTION_HMAC_KEY_FILE, or the database verification key.
# The signer has its own example, .env.signer.example. The API refuses to start if an HMAC key is present.
# The database operator installs the verification key in the private key table in a later milestone.
# That value is not an environment variable.
# The signer URL is fixed. Any other host or port is rejected.
NYUMA_IDENTITY_MODE=local-hs256-test
SIGNER_URL=http://127.0.0.1:8791
SIGNER_CLIENT_CREDENTIAL=
