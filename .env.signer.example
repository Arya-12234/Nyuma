# Signer process only. The API does not load this file.
# Copy it to .env.signer outside the API environment and supply those variables only to `npm run signer`.
# Do not copy this file to .env or server/.env. Those files are loaded by the API.
# Leave every secret empty. Do not commit .env.signer.
# SIGNER_HOST must stay 127.0.0.1. SIGNER_PORT must not be 8787.
# The client credential is the same value the API holds. It is at least 32 random bytes.
# Set exactly one HMAC key source. The key is 32 bytes, as base64url or 64 hex characters.
# A key file must be readable only by the signer account, SYSTEM, and Administrators.
# On Unix the file mode must not grant group or world access.
# SIGNER_CLIENT_CREDENTIAL_NEXT is optional and is used only while rotating the client credential.
# The database verification key is not set here. The database operator installs it separately.

SIGNER_HOST=127.0.0.1
SIGNER_PORT=8791
SUPABASE_URL=https://your-project-ref.supabase.co
ASSERTION_KEY_ID=
ASSERTION_HMAC_KEY=
ASSERTION_HMAC_KEY_FILE=
SIGNER_CLIENT_CREDENTIAL=
SIGNER_CLIENT_CREDENTIAL_NEXT=
